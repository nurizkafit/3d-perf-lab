# Production environment (DEPLOYMENT.md §4). Copy to app-core/.env on the server and fill in the values.
# Never commit the filled file. Never set APP_DEBUG=true in production.
APP_NAME="3D Render Test Dashboard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
# Dates are stored in UTC and shown in this zone (LOG.md D38).
APP_DISPLAY_TIMEZONE=Asia/Jakarta
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# hPanel → Databases. Confirm the host (often localhost) and the driver (mariadb or mysql).
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# No worker daemon: the scheduler runs the jobs on the sync connection (routes/console.php).
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Must be ≤ the PHP upload_max_filesize and post_max_size (DEPLOYMENT.md §2).
ASSET_MAX_UPLOAD_MB=50
STAGING_RETENTION_DAYS=7

# Used once by ProductionSeeder to create the first admin. Remove the password after the first login.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
